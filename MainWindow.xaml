<Window x:Class="ImageViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Visualizador de Imagens"
        Width="1100" Height="720" MinWidth="520" MinHeight="380"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        MouseDown="Window_MouseDown"
        Drop="Window_Drop">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top command bar -->
        <DockPanel x:Name="TopBar" Margin="14,6,8,4" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource IconButton}" Content="&#xE8E5;" Click="Open_Click" ToolTip="Abrir (Ctrl+O)" />
                <Button x:Name="RevealButton" Style="{StaticResource IconButton}" Content="&#xE838;" Click="Reveal_Click" ToolTip="Mostrar na pasta" />
                <Button x:Name="CopyButton" Style="{StaticResource IconButton}" Content="&#xE8C8;" Click="Copy_Click" ToolTip="Copiar (Ctrl+C)" />
                <Button x:Name="PropertiesButton" Style="{StaticResource IconButton}" Content="&#xE946;" Click="Properties_Click" ToolTip="Propriedades (Alt+Enter)" />
                <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Content="&#xE712;" Click="More_Click" ToolTip="Mais opções">
                    <Button.ContextMenu>
                        <!-- Reset the font: a ContextMenu inherits the button's icon font otherwise -->
                        <ContextMenu FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14">
                            <MenuItem Header="Definir como aplicativo padrão..." Click="SetDefault_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE7EE;" FontFamily="{StaticResource IconFont}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Abrir com outro aplicativo..." Click="OpenWith_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE7AC;" FontFamily="{StaticResource IconFont}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Atalhos do teclado" Click="Shortcuts_Click">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="FileNameText" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           MaxWidth="700" VerticalAlignment="Center" />
                <TextBlock x:Name="IndexText" Margin="12,1,0,0" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </DockPanel>

        <!-- Image viewport -->
        <Grid x:Name="Viewport" Grid.Row="1" ClipToBounds="True" Background="Transparent"
              SizeChanged="Viewport_SizeChanged"
              MouseWheel="Viewport_MouseWheel"
              MouseLeftButtonDown="Viewport_MouseLeftButtonDown"
              MouseLeftButtonUp="Viewport_MouseLeftButtonUp"
              MouseMove="Viewport_MouseMove"
              MouseLeave="Viewport_MouseLeave"
              LostMouseCapture="Viewport_LostMouseCapture">
            <!-- Canvas: the image must not be clipped by its layout slot, only by the viewport -->
            <Canvas>
                <Image x:Name="Img" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.RenderTransform>
                        <MatrixTransform x:Name="ImgTransform" />
                    </Image.RenderTransform>
                </Image>
            </Canvas>

            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE91B;" FontFamily="{StaticResource IconFont}" FontSize="48" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="Nenhuma imagem aberta" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,4"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Arraste uma imagem para cá ou escolha um arquivo." HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <Button Content="Abrir imagem" Style="{DynamicResource AccentButtonStyle}" Margin="0,20,0,0" Padding="20,6"
                        HorizontalAlignment="Center" Click="Open_Click" />
            </StackPanel>

            <StackPanel x:Name="ErrorState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="40" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="Não foi possível exibir esta imagem" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,4"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="ErrorDetail" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="460" TextAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Button x:Name="PrevOverlay" Style="{StaticResource NavOverlayButton}" HorizontalAlignment="Left"
                    Content="&#xE76B;" Click="Prev_Click" ToolTip="Anterior (←)" />
            <Button x:Name="NextOverlay" Style="{StaticResource NavOverlayButton}" HorizontalAlignment="Right"
                    Content="&#xE76C;" Click="Next_Click" ToolTip="Próxima (→)" />

            <Border x:Name="Toast" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16,8"
                    CornerRadius="8" BorderThickness="1" Opacity="0" IsHitTestVisible="False"
                    Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <TextBlock x:Name="ToastText" FontSize="16" FontWeight="SemiBold" />
            </Border>
        </Grid>

        <!-- Bottom bar -->
        <Grid x:Name="BottomBar" Grid.Row="2" Margin="14,4,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="InfoText" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,12,0" />

            <Border Grid.Column="1" CornerRadius="8" BorderThickness="1" Padding="3"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ZoomOutButton" Style="{StaticResource IconButton}" Content="&#xE71F;" Click="ZoomOut_Click" ToolTip="Reduzir (-)" />
                    <Button x:Name="ZoomText" Style="{StaticResource TextToolButton}" Click="ZoomText_Click"
                            ToolTip="Alternar entre ajustar à janela e tamanho real (duplo clique na imagem)">
                        <TextBlock x:Name="ZoomLabelText" Text="100%" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" />
                    </Button>
                    <Button x:Name="ZoomInButton" Style="{StaticResource IconButton}" Content="&#xE8A3;" Click="ZoomIn_Click" ToolTip="Ampliar (+)" />
                    <Button x:Name="FitButton" Style="{StaticResource IconButton}" Content="&#xE9A6;" Click="Fit_Click" ToolTip="Ajustar à janela (Ctrl+0)" />
                    <Border Style="{StaticResource ToolSeparator}" />
                    <Button x:Name="PrevButton" Style="{StaticResource IconButton}" Content="&#xE892;" Click="Prev_Click" ToolTip="Anterior (←)" />
                    <Button x:Name="NextButton" Style="{StaticResource IconButton}" Content="&#xE893;" Click="Next_Click" ToolTip="Próxima (→)" />
                    <Border Style="{StaticResource ToolSeparator}" />
                    <Button x:Name="RotateLeftButton" Style="{StaticResource IconButton}" Click="RotateLeft_Click" ToolTip="Girar para a esquerda (Ctrl+,)">
                        <TextBlock Text="&#xE7AD;" FontFamily="{StaticResource IconFont}" FontSize="16" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <ScaleTransform ScaleX="-1" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Button>
                    <Button x:Name="RotateRightButton" Style="{StaticResource IconButton}" Content="&#xE7AD;" Click="RotateRight_Click" ToolTip="Girar para a direita (Ctrl+.)" />
                    <Border Style="{StaticResource ToolSeparator}" />
                    <Button x:Name="DeleteButton" Style="{StaticResource IconButton}" Content="&#xE74D;" Click="Delete_Click" ToolTip="Excluir (Del)" />
                </StackPanel>
            </Border>

            <Button x:Name="FullScreenButton" Grid.Column="2" HorizontalAlignment="Right" Style="{StaticResource IconButton}"
                    Content="&#xE740;" Click="FullScreen_Click" ToolTip="Tela inteira (F11)" />
        </Grid>

        <!-- Delete confirmation (Windows 11 ContentDialog look) -->
        <Grid x:Name="DeleteOverlay" Grid.RowSpan="3" Visibility="Collapsed"
              Background="{DynamicResource SmokeFillColorDefaultBrush}">
            <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="8"
                    BorderThickness="1" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.3" Direction="270" />
                </Border.Effect>
                <StackPanel>
                    <StackPanel Margin="24,22,24,24">
                        <TextBlock Text="Excluir arquivo?" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap">
                            <Run x:Name="DeleteFileName" FontWeight="SemiBold" />
                            <Run Text="será movido para a Lixeira." />
                        </TextBlock>
                    </StackPanel>
                    <Border CornerRadius="0,0,8,8" Padding="24" BorderThickness="0,1,0,0"
                            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="DeleteConfirmButton" Content="Excluir" Style="{DynamicResource AccentButtonStyle}"
                                    HorizontalAlignment="Stretch" Click="DeleteConfirm_Click" />
                            <Button Grid.Column="2" Content="Cancelar" HorizontalAlignment="Stretch" Click="DeleteCancel_Click" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
